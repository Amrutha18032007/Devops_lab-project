2. run_security.py
import re
import json
from pathlib import Path
from datetime import datetime

BASE_DIR = Path(__file__).parent
REPORT_DIR = BASE_DIR / "reports"
REPORT_DIR.mkdir(exist_ok=True)

app_file = BASE_DIR / "app.py"
requirements_file = BASE_DIR / "requirements.txt"

issues = []
checks = []

# Check 1: Scan application code
if app_file.exists():
    code = app_file.read_text(encoding="utf-8")

    secret_pattern = re.compile(
        r"""(?i)\b(password|api_key|secret|token)\s*=\s*['"][^'"]+['"]"""
    )

    if secret_pattern.search(code):
        issues.append("Possible hardcoded secret found")
    else:
        checks.append("No obvious hardcoded secrets found")

    if re.search(r"\b(eval|exec)\s*\(", code):
        issues.append("Potentially unsafe eval/exec usage found")
    else:
        checks.append("No eval/exec usage found")

    if re.search(r"debug\s*=\s*True", code):
        issues.append("Flask debug mode is enabled")
    else:
        checks.append("Flask debug mode is not enabled")
else:
    issues.append("app.py not found")

# Check 2: Check dependency version pinning
if requirements_file.exists():
    dependencies = requirements_file.read_text(
        encoding="utf-8"
    ).splitlines()

    unpinned = [
        line.strip()
        for line in dependencies
        if line.strip()
        and not line.strip().startswith("#")
        and "==" not in line
    ]

    if unpinned:
        issues.append(
            "Dependencies without pinned versions: "
            + ", ".join(unpinned)
        )
    else:
        checks.append("Dependency versions are pinned")
else:
    issues.append("requirements.txt not found")

# Build report
status = "PASS" if not issues else "FAIL"

report = {
    "project": "SecureShip",
    "timestamp": datetime.now().isoformat(timespec="seconds"),
    "status": status,
    "checks_passed": checks,
    "issues_found": issues,
    "note": (
        "Basic demonstration checks only; "
        "not a complete security audit."
    )
}

report_file = REPORT_DIR / "security_report.json"
report_file.write_text(json.dumps(report, indent=4), encoding="utf-8")

print("=" * 45)
print("       SECURESHIP SECURITY SCANNER")
print("=" * 45)

for check in checks:
    print("[PASS]", check)

for issue in issues:
    print("[FAIL]", issue)

print("-" * 45)
print("Final Status :", status)
print("Issues Found :", len(issues))
print("Report Saved :", report_file)
print("=" * 45)

